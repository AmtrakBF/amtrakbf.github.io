<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WGU_App_RileyJuniewic.Forms.HomePage"
             xmlns:components="clr-namespace:WGU_App_RileyJuniewic.Forms.Components"
             xmlns:courseComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.CourseComponents"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout>
        <components:HeaderComp />

        <CollectionView ItemsSource="{Binding FullCourses}" HorizontalOptions="Center">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView>
                        <VerticalStackLayout>
                            <courseComponents:CourseCard Course="{Binding Course}" Instructor="{Binding Instructor}" />
                        </VerticalStackLayout>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Add Course" Margin="0,20,0,20" Clicked="Button_Clicked" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>