<instructorComponents:ModifyInstructorContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WGU_App_RileyJuniewic.Forms.Components.InstructorComponents.AddInstructorCard"
             xmlns:instructorComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.InstructorComponents"
             x:Name="addInstructorCard">

     <VerticalStackLayout>
        <instructorComponents:ModifyInstructorCard CardTitle="Create Instructor" Name="{Binding CreateInstructorRequest.Name}"
            Phone="{Binding CreateInstructorRequest.Phone}" Email="{Binding CreateInstructorRequest.Email}"/>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
            <Button Text="Cancel" Clicked="Close_View"/>
            <Button Text="Create Instructor" Command="{Binding CreateInstructorCommandAsync}"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>

</instructorComponents:ModifyInstructorContentView>