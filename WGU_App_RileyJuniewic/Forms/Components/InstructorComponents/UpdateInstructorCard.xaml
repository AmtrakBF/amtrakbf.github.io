<forms:ModifyContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WGU_App_RileyJuniewic.Forms.Components.InstructorComponents.UpdateInstructorCard"
             xmlns:forms="clr-namespace:WGU_App_RileyJuniewic.Forms"
             xmlns:instructorComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.InstructorComponents"
             x:Name="updateInstructorCard">

    <VerticalStackLayout>
        <instructorComponents:ModifyInstructorCard CardTitle="Modify Instructor" Name="{Binding ModifyRequest.Name}"
            Phone="{Binding ModifyRequest.Phone}" Email="{Binding ModifyRequest.Email}" ValidationErrors="{Binding ModifyRequest.ValidationErrors}"/>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
            <Button Text="Cancel" Clicked="Close_View"/>
            <Button Text="Delete" Command="{Binding DeleteCommandAsync}"/>
            <Button Text="Update Instructor" Command="{Binding ModifyCommandAsync}"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>

</forms:ModifyContentView>