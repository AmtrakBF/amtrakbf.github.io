<forms:BaseInputContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WGU_App_RileyJuniewic.Forms.Components.InstructorComponents.ModifyInstructorCard"
             xmlns:converters="clr-namespace:WGU_App_RileyJuniewic.Data.Misc.Converters"
             xmlns:forms="clr-namespace:WGU_App_RileyJuniewic.Forms"
             x:Name="modifyInstructorCard">

    <ContentView.Resources>
        <converters:ErrorsToStringConverter x:Key="ErrorsToString"/>
        <converters:ErrorsToBoolConverter x:Key="ErrorsToBool"/>
    </ContentView.Resources>

    <Border Padding="20" StrokeShape="RoundRectangle 10" Margin="20">
        <VerticalStackLayout>
            <Label FontSize="Large" Margin="0,0,0,30" Text="{Binding CardTitle, Source={x:Reference modifyInstructorCard}}" HorizontalTextAlignment="Center"/>

            <VerticalStackLayout HorizontalOptions="Center" WidthRequest="250">
                <Label Text="Name:"/>
                <Entry Text="{Binding Name, Source={x:Reference modifyInstructorCard}}" />
                <Label Text="{Binding ValidationErrors, Source={x:Reference modifyInstructorCard}, Converter={StaticResource ErrorsToString}, ConverterParameter=Name}" 
                    TextColor="Red" FontSize="Small" Margin="0,0,0,10"
                    IsVisible="{Binding ValidationErrors, Source={x:Reference modifyInstructorCard}, Converter={StaticResource ErrorsToBool}, ConverterParameter=Name}"/>

                <Label Text="Phone Number:"/>
                <Entry Keyboard="Numeric" Text="{Binding Phone, Source={x:Reference modifyInstructorCard}}"/>
                <Label Text="{Binding ValidationErrors, Source={x:Reference modifyInstructorCard}, Converter={StaticResource ErrorsToString}, ConverterParameter=Phone}"
                    TextColor="Red" FontSize="Small" Margin="0,0,0,10" 
                    IsVisible="{Binding ValidationErrors, Source={x:Reference modifyInstructorCard}, Converter={StaticResource ErrorsToBool}, ConverterParameter=Phone}"/>

                <Label Text="Email:"/>
                <Entry Text="{Binding Email, Source={x:Reference modifyInstructorCard}}"/>
                <Label Text="{Binding ValidationErrors, Source={x:Reference modifyInstructorCard}, Converter={StaticResource ErrorsToString}, ConverterParameter=Email}"
                    TextColor="Red" FontSize="Small" Margin="0,0,0,10"
                    IsVisible="{Binding ValidationErrors, Source={x:Reference modifyInstructorCard}, Converter={StaticResource ErrorsToBool}, ConverterParameter=Email}"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>

</forms:BaseInputContentView>