<forms:ModifyContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WGU_App_RileyJuniewic.Forms.Components.TermComponents.AddTermCard"
             xmlns:termComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.TermComponents"
             xmlns:forms="clr-namespace:WGU_App_RileyJuniewic.Forms"
             x:Name="addTermCard">

     <VerticalStackLayout>
        <termComponents:ModifyTermComponent CardTitle="Add Term" Title="{Binding CreateRequest.Title}"
            StartDate="{Binding CreateRequest.StartDate}" EndDate="{Binding CreateRequest.EndDate}" ValidationErrors="{Binding CreateRequest.ValidationErrors}"/>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
            <Button Text="Cancel" Clicked="Close_View"/>
            <Button Text="Create Term" Command="{Binding CreateCommandAsync}"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>

</forms:ModifyContentView>