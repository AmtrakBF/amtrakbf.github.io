<forms:ModifyContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="WGU_App_RileyJuniewic.Forms.Components.TermComponents.UpdateTermComponent"
            xmlns:local="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.TermComponents"
            xmlns:termComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.TermComponents"
            xmlns:forms="clr-namespace:WGU_App_RileyJuniewic.Forms"
            x:Name="updateTermComponent">
    <VerticalStackLayout>
        <termComponents:ModifyTermComponent CardTitle="Update Term" Title="{Binding ModifyRequest.Title}" 
            StartDate="{Binding ModifyRequest.StartDate}" EndDate="{Binding ModifyRequest.EndDate}" ValidationErrors="{Binding ModifyRequest.ValidationErrors}"/>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
            <Button Text="Cancel" Clicked="Close_View"/>
            <Button Text="Delete" BackgroundColor="{StaticResource Red}" Command="{Binding DeleteCommandAsync}"/>
            <Button Text="Update Term" Command="{Binding ModifyCommandAsync}"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</forms:ModifyContentView>