<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="WGU_App_RileyJuniewic.Forms.CourseForms.AddCoursePage"
            xmlns:courseComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.CourseComponents"
            xmlns:assessmentComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.AssessmentComponents"
            xmlns:instructorComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.InstructorComponents"
            xmlns:components="clr-namespace:WGU_App_RileyJuniewic.Forms.Components"
            xmlns:converters="clr-namespace:WGU_App_RileyJuniewic.Data.Misc.Converters"
            x:Name="addCoursePage"
            Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <converters:ErrorsToStringConverter x:Key="ErrorsToString"/>
        <converters:ErrorsToBoolConverter x:Key="ErrorsToBool"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout>

            <Label FontSize="Title" Text="Create Course" HorizontalOptions="Center" Margin="0,20,0,20"/>

            <courseComponents:ModifyCourseCard CardTitle="Course Details" Title="{Binding CreateRequest.Title}" 
                Notes="{Binding CreateRequest.Notes}" Status="{Binding CreateRequest.Status}" StartDate="{Binding CreateRequest.StartDate}"
                EndDate="{Binding CreateRequest.EndDate}" ValidationErrors="{Binding CreateRequest.ValidationErrors}"/>

            <instructorComponents:InstructorCard SelectedInstructor="{Binding Source={x:Reference addCoursePage}, Path=BindingContext.Instructor}" />
            <Label Text="{Binding CreateRequest.ValidationErrors, Converter={StaticResource ErrorsToString}, ConverterParameter=InstructorId}"
                    TextColor="Red" FontSize="Small" Margin="0,0,0,10" HorizontalTextAlignment="Center"
                    IsVisible="{Binding CreateRequest.ValidationErrors, Converter={StaticResource ErrorsToBool}, ConverterParameter=InstructorId}"/>

            <CollectionView ItemsSource="{Binding Assessments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <assessmentComponents:ModifyAssessmentCard CardTitle="Create Assessment" Name="{Binding Name}" 
                            ButtonText="Delete Assessment" ButtonEvent="{Binding ButtonEvent, Source={x:Reference addCoursePage}}"
                            Type="{Binding Type}" StartDate="{Binding StartDate}" EndDate="{Binding EndDate}" ValidationErrors="{Binding ValidationErrors}" />
                                
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Add Assessment" Command="{Binding AddAssessmentCommand}" Margin="0,20,0,20" HorizontalOptions="Center" />

            <Button Text="Create Course" Command="{Binding CreateCommandAsync}" Margin="40" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>