<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="WGU_App_RileyJuniewic.Forms.CourseForms.AddCoursePage"
            xmlns:courseComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.CourseComponents"
            xmlns:assessmentComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.AssessmentComponents"
            xmlns:instructorComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.InstructorComponents"
            xmlns:components="clr-namespace:WGU_App_RileyJuniewic.Forms.Components"
            Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout>

            <Label FontSize="Title" Text="Create Course" HorizontalOptions="Center" Margin="0,20,0,20"/>

            <courseComponents:ModifyCourseCard CardTitle="Course Details" Title="{Binding CreateCourseRequest.Title}" 
                Status="{Binding CreateCourseRequest.Status}" StartDate="{Binding CreateCourseRequest.StartDate}" 
                EndDate="{Binding CreateCourseRequest.EndDate}" ValidationErrors="{Binding CreateCourseRequest.ValidationErrors}"/>

            <instructorComponents:InstructorCard SelectedInstructor="{Binding Instructor}"/>

            <CollectionView ItemsSource="{Binding CreateCourseRequest.Assessments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <assessmentComponents:ModifyAssessmentCard CardTitle="Create Assessment" Name="{Binding Name}" 
                            Type="{Binding Type}" StartDate="{Binding StartDate}" EndDate="{Binding EndDate}" ValidationErrors="{Binding ValidationErrors}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <assessmentComponents:ModifyAssessmentCard CardTitle="Assessment Details" Name="{Binding CreateCourseRequest.Assessment.Name}" 
                Type="{Binding CreateCourseRequest.Assessment.Type}" StartDate="{Binding CreateCourseRequest.Assessment.StartDate}" 
                EndDate="{Binding CreateCourseRequest.Assessment.EndDate}" />

            <Button Text="Add Course" Margin="0,20,0,20" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>