<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="WGU_App_RileyJuniewic.Forms.AssessmentForms.CreateAssessmentPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:assessmentComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.AssessmentComponents"
             Shell.NavBarIsVisible="True">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            
            <Label Text="{Binding Course.Title}" />

            <assessmentComponents:ModifyAssessmentCard CardTitle="Create Assessment" Name="{Binding CreateRequest.Name}"
                Type="{Binding CreateRequest.Type}" StartDate="{Binding CreateRequest.StartDate}" EndDate="{Binding CreateRequest.EndDate}"
                ValidationErrors="{Binding CreateRequest.ValidationErrors}"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                <Button Text="Cancel" Clicked="GoBackEventHandler"/>
                <Button Text="Create Assessment" Command="{Binding CreateCommandAsync}"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>