<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WGU_App_RileyJuniewic.Forms.SelectedTermPage"
             xmlns:components="clr-namespace:WGU_App_RileyJuniewic.Forms.Components"
             xmlns:courseComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.CourseComponents"
             xmlns:converter="clr-namespace:WGU_App_RileyJuniewic.Data.Misc.Converters"
             x:Name="selectedTermPage"
             Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:NullToBooleanConverter x:Key="NullToBoolean" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout>
                <Label Text="{Binding Term.Title}" FontSize="Large" Margin="0,20,0,20" HorizontalOptions="Center" />

                <VerticalStackLayout IsVisible="{Binding Term, Converter={StaticResource NullToBoolean}}">
                    <CollectionView ItemsSource="{Binding FullCourses}" HorizontalOptions="Center">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <ContentView>
                                    <VerticalStackLayout>
                                        <courseComponents:CourseCard Course="{Binding Course}" Instructor="{Binding Instructor}" ButtonTitle="Open"
                                            ButtonEvent="{Binding ButtonEventHandler, Source={x:Reference selectedTermPage}}"/>
                                    </VerticalStackLayout>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout IsVisible="{Binding EmptyCoursesList}">
                        <Label Margin="0,50" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" Text="No courses found" FontSize="Large"/>
                    </VerticalStackLayout>

                    <Button Text="Add Course" Margin="0,20,0,20" Clicked="Add_Course_Clicked" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding Term, Converter={StaticResource NullToBoolean}, ConverterParameter=True}">
                    <Label Margin="0,50" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" Text="No term found" FontSize="Large"/>
                    <Button Text="Add Term" Clicked="Add_Term_Clicked" Margin="40"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>