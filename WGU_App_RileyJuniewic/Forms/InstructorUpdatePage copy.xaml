<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="WGU_App_RileyJuniewic.Forms.InstructorForms.InstructorUpdatePage"
            xmlns:instructorComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.InstructorComponents"
            xmlns:converters="clr-namespace:WGU_App_RileyJuniewic.Data.Misc.Converters"
            x:Name="updateInstructorPage"
            Title="Update Instructor"
            Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout>
            <instructorComponents:UpdateInstructorCard Instructor="{Binding Instructor,Source={x:Reference updateInstructorPage}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>