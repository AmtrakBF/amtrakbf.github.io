<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="WGU_App_RileyJuniewic.Forms.AssessmentForms.ModifyAssessmentPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:assessmentComponents="clr-namespace:WGU_App_RileyJuniewic.Forms.Components.AssessmentComponents"
             Shell.NavBarIsVisible="True">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            
            <Label Text="{Binding Course.Title}" />

            <assessmentComponents:ModifyAssessmentCard CardTitle="Modify Assessment" Name="{Binding ModifyRequest.Name}"
                Type="{Binding ModifyRequest.Type}" StartDate="{Binding ModifyRequest.StartDate}" EndDate="{Binding ModifyRequest.EndDate}"
                ValidationErrors="{Binding ModifyRequest.ValidationErrors}"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                <Button Text="Cancel" Clicked="GoBackEventHandler"/>
                <Button Text="Delete" Command="{Binding DeleteCommandAsync}"/>
                <Button Text="Update Assessment" Command="{Binding ModifyCommandAsync}"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>