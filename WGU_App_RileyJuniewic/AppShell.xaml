<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WGU_App_RileyJuniewic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="clr-namespace:WGU_App_RileyJuniewic.Forms"
    Title="WGU_App_RileyJuniewic"
    Shell.FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="False">

    <FlyoutItem Title="Home">
        <ShellContent
            Title="Current Term"
            ContentTemplate="{DataTemplate forms:CurrentTermPage}"
            Route="CurrentTermPage" />

        <ShellContent
            Title="Terms"
            ContentTemplate="{DataTemplate forms:ViewTermsPage}"
            Route="ViewTermsPage" />
            
    </FlyoutItem>

</Shell>
